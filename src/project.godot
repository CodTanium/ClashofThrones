; Godot project file. Game code is C# (.NET 10); see scripts/.

config_version=5

[application]

config/name="Clash of Thrones"
config/description="A 2D dark-fantasy action platformer."
config/version="0.3.0"
run/main_scene="res://scenes/Menu.tscn"
config/features=PackedStringArray("4.7", "C#", "Forward Plus")
config/icon="res://icon.svg"
boot_splash/bg_color=Color(0.03, 0.03, 0.05, 1)

[autoload]

Game="*res://scripts/core/Game.cs"
DevBridge="*res://scripts/dev/DevBridge.cs"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1920
window/size/window_height_override=1080
window/stretch/mode="viewport"
window/stretch/scale_mode="integer"

[dotnet]

project/assembly_name="ClashOfThrones"

[rendering]

textures/canvas_textures/default_texture_filter=0
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true
environment/defaults/default_clear_color=Color(0.03, 0.03, 0.05, 1)